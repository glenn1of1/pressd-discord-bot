# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# ── Discord ──────────────────────────────────────────────────────────────
# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# Dev switch. SET locally for instant command sync to one test server.
# LEAVE UNSET in production — an unset value triggers a global sync that
# reaches every server the bot is in. Setting it in production limits the
# bot's commands to that one guild.
DISCORD_GUILD_ID=

# ── HenrikDev Valorant API ───────────────────────────────────────────────
# Key from https://api.henrikdev.xyz/dashboard
HENRIK_API_KEY=

# Outbound requests per minute. The free Basic key allows 30, so the default
# of 25 leaves room for retries. Raise to ~80 on the paid Enhanced key (90).
# Requests beyond the budget wait rather than fail.
HENRIK_RATE_LIMIT=25

# ── Bot behaviour ────────────────────────────────────────────────────────
# Seconds a player's computed stats stay cached. Longer means fewer API
# calls and staler numbers. Shared by /stats, /compare, and /leaderboard.
STATS_CACHE_TTL=300

# Default region when /register is called without one.
DEFAULT_REGION=na

# "template" (default) or "ai". The ai path is not implemented and falls
# back to templates.
BANTER_MODE=template

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ── Storage ──────────────────────────────────────────────────────────────
# Absolute path to the SQLite file. In production this MUST point inside a
# mounted persistent volume (e.g. /data/valorant_bot.db) or every redeploy
# wipes all registrations. Unset locally is fine — it falls back to a file
# in the project root.
DB_PATH=

# ── Optional ─────────────────────────────────────────────────────────────
# Only needed if BANTER_MODE=ai is ever implemented.
OPENAI_API_KEY=
